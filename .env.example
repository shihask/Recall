# ── Frontend (Vercel env vars / local .env) ──────────────────────────────────
# Only browser-safe values belong here. Anything prefixed VITE_ ships to clients.
VITE_SUPABASE_URL=https://your-recall-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Edge Function secrets (NEVER prefix with VITE_, never commit) ────────────
# Set with: supabase secrets set AI_API_KEY=... AI_MODEL=... CRON_SECRET=...
# AI_API_KEY=your-groq-api-key
# AI_MODEL=openai/gpt-oss-20b
# EMBEDDING_MODEL=gte-small
# META_OEMBED_TOKEN=APP_ID|CLIENT_TOKEN   (optional: official Instagram/Facebook previews; Meta app with oEmbed Read)
# UNOFFICIAL_SOCIAL_PREVIEWS=true   (optional, off by default: when oEmbed returns nothing, fetch Instagram/Facebook posts as a link-preview bot; against their terms, see README)
# CRON_SECRET=long-random-string-used-only-by-the-retry-worker
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by Supabase.
